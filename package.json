{
  "name": "simple-latex-preview",
  "displayName": "Simple LaTeX Preview",
  "description": "Lightweight LaTeX preview that also works in VS Code for the Web",
  "version": "0.0.5",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kmmz532/vscode-latex-preview.git"
  },
  "bugs": {
    "url": "https://github.com/kmmz532/vscode-latex-preview/issues"
  },
  "homepage": "https://github.com/kmmz532/vscode-latex-preview#readme",
  "publisher": "kmmz1127",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "katex",
    "jsarticle",
    "vscode.dev",
    "github.dev"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "aliases": [
          "LaTeX",
          "latex"
        ],
        "extensions": [
          ".tex",
          ".ltx"
        ]
      }
    ],
    "configuration": {
      "title": "LaTeX Preview",
      "properties": {
        "latexPreview.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "Delay in milliseconds before the preview updates after an edit."
        },
        "latexPreview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "The preview follows the active .tex editor. Use the lock button in the preview to keep showing a specific file. When false, each file gets its own preview."
        },
        "latexPreview.mathMacros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "KaTeX macros available in every document, e.g. `{ \"\\\\R\": \"\\\\mathbb{R}\" }` (in settings.json). Macros defined in the document with `\\newcommand` take precedence."
        },
        "latexPreview.paginate": {
          "type": "boolean",
          "default": true,
          "description": "Split documents with \\documentclass into pages of \\textheight. When false, the document is shown as one continuous page."
        },
        "latexPreview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync scrolling between the editor and the preview."
        },
        "latexPreview.showUnknownCommands": {
          "type": "boolean",
          "default": true,
          "description": "Show unsupported commands as dimmed source text."
        }
      }
    },
    "commands": [
      {
        "command": "latexPreview.openPreview",
        "title": "Open Preview",
        "category": "LaTeX Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "latexPreview.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "LaTeX Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "latexPreview.openSettings",
        "title": "Open Settings",
        "category": "LaTeX Preview",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "latexPreview.openPreviewToSide",
          "when": "resourceLangId == latex",
          "group": "navigation"
        },
        {
          "command": "latexPreview.openSettings",
          "when": "activeWebviewPanelId == 'latexPreview'",
          "group": "latexPreview@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-web",
    "compile-web": "node esbuild.mjs",
    "watch-web": "node esbuild.mjs --watch",
    "package-web": "node esbuild.mjs --production",
    "run-in-browser": "node scripts/run-in-browser.mjs",
    "test": "node test/golden.mjs",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/vscode": "^1.90.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.24.0",
    "katex": "^0.19.0",
    "typescript": "^5.6.0"
  }
}
