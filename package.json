{
  "name": "simple-latex-preview",
  "displayName": "Simple LaTeX Preview",
  "description": "%extension.description%",
  "version": "1.0.1",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kmmz532/vscode-latex-preview.git"
  },
  "bugs": {
    "url": "https://github.com/kmmz532/vscode-latex-preview/issues"
  },
  "homepage": "https://github.com/kmmz532/vscode-latex-preview#readme",
  "publisher": "kmmz1127",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "latex",
    "tex",
    "preview",
    "katex",
    "jsarticle",
    "vscode.dev",
    "github.dev"
  ],
  "activationEvents": [
    "onLanguage:latex"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "latex",
        "aliases": [
          "LaTeX",
          "latex"
        ],
        "extensions": [
          ".tex",
          ".ltx"
        ]
      }
    ],
    "configuration": {
      "title": "LaTeX Preview",
      "properties": {
        "latexPreview.debounceMs": {
          "type": "number",
          "default": 200,
          "description": "%config.debounceMs%"
        },
        "latexPreview.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "%config.followActiveEditor%"
        },
        "latexPreview.mathMacros": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.mathMacros%"
        },
        "latexPreview.paginate": {
          "type": "boolean",
          "default": true,
          "description": "%config.paginate%"
        },
        "latexPreview.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "%config.scrollSync%"
        },
        "latexPreview.showUnknownCommands": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUnknownCommands%"
        }
      }
    },
    "commands": [
      {
        "command": "latexPreview.openPreview",
        "title": "%command.openPreview%",
        "category": "LaTeX Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "latexPreview.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "category": "LaTeX Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "latexPreview.openSettings",
        "title": "%command.openSettings%",
        "category": "LaTeX Preview",
        "icon": "$(gear)"
      },
      {
        "command": "latexPreview.lock",
        "title": "%command.lock%",
        "category": "LaTeX Preview",
        "icon": "$(unlock)"
      },
      {
        "command": "latexPreview.unlock",
        "title": "%command.unlock%",
        "category": "LaTeX Preview",
        "icon": "$(lock)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "latexPreview.openPreviewToSide",
          "when": "resourceLangId == latex",
          "group": "navigation"
        },
        {
          "command": "latexPreview.openSettings",
          "when": "activeWebviewPanelId == 'latexPreview'",
          "group": "latexPreview@1"
        },
        {
          "command": "latexPreview.lock",
          "when": "activeWebviewPanelId == 'latexPreview' && !latexPreview.locked",
          "group": "navigation"
        },
        {
          "command": "latexPreview.unlock",
          "when": "activeWebviewPanelId == 'latexPreview' && latexPreview.locked",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "latexPreview.lock",
          "when": "activeWebviewPanelId == 'latexPreview' && !latexPreview.locked"
        },
        {
          "command": "latexPreview.unlock",
          "when": "activeWebviewPanelId == 'latexPreview' && latexPreview.locked"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package-web",
    "compile-web": "node esbuild.mjs",
    "watch-web": "node esbuild.mjs --watch",
    "package-web": "node esbuild.mjs --production",
    "run-in-browser": "node scripts/run-in-browser.mjs",
    "test": "node test/golden.mjs",
    "release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/vscode": "^1.90.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.24.0",
    "katex": "^0.19.0",
    "typescript": "^5.6.0"
  },
  "l10n": "./l10n"
}
